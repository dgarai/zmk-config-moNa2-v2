/*
 * SPDX-License-Identifier: MIT
 *
 * roBa (zmk-config-roBa) のキーマップを moNa2 へ移植したもの。
 *
 * 【レイアウト差分】
 *   roBa   : 43キー（2段目の左内側 RC(1,5) が存在する）
 *   moNa2  : 42キー（2段目の左内側キーが無い）
 *   → 各レイヤーの 2段目 6番目にあった roBa の RC(1,5) を1つ削除して移植。
 *      実際に何か割り当てられていたのは 2箇所だけ：
 *        default : &kp LS(LG(S))            （macOS スクリーンショット）
 *        NUM     : &kp LC(LA(KP_NUMBER_0))
 *      いずれも moNa2 には置き場所が無いため未割当。必要なら任意のキーへ。
 *
 * 【レイヤー番号】roBa と同一
 *   0 default / 1 ARROW / 2 KIGOU / 3 Bluetooth / 4 MOUSE / 5 SCROLL / 6 NUM / 7 FUNCTION
 *   → オートマウスレイヤー = 4、スクロールレイヤー = 5 として
 *     boards/shields/mona2/mona2_r.overlay 側も合わせて修正済み。
 */

#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <zephyr/dt-bindings/input/input-event-codes.h>

#define ZMK_POINTING_DEFAULT_SCRL_VAL 80

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <0>;
};

/ {
    combos {
        compatible = "zmk,combos";

        // roBa: <18 20> → moNa2: <17 19>（J + L）

        Center {
            bindings = <&mkp MB3>;
            key-positions = <17 19>;
            timeout-ms = <80>;              // 50→80。同時押しをゆるく
            require-prior-idle-ms = <125>;  // 打鍵中は発火させない
        };

        // roBa: <18 19> → moNa2: <17 18>（J + K）

        left {
            bindings = <&mkp MB1>;
            key-positions = <17 18>;
            timeout-ms = <80>;              // 50→80。同時押しをゆるく
            require-prior-idle-ms = <125>;  // 打鍵中は発火させない
        };

        // roBa: <19 20> → moNa2: <18 19>（K + L）

        right {
            bindings = <&mkp MB2>;
            key-positions = <18 19>;
            timeout-ms = <80>;              // 50→80。同時押しをゆるく
            require-prior-idle-ms = <125>;  // 打鍵中は発火させない
        };

        // roBa: <0 1> → moNa2: <0 1>（Q + W）位置変化なし

        Escape {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
            timeout-ms = <80>;              // 50→80。同時押しをゆるく
            require-prior-idle-ms = <125>;  // 打鍵中は発火させない
        };

        tab {
            bindings = <&kp TAB>;
            key-positions = <4 3>;
        };
    };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        // エンコーダ用マウスホイールスクロール（上下）

        encoder_scroll: encoder_scroll {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>;
        };

        // --- 以下は moNa2 標準の定義。現キーマップでは未使用だが温存 ---

        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            quick-tap-ms = <180>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
            tapping-term-ms = <300>;
        };

        ltq: ltq {
            compatible = "zmk,behavior-hold-tap";
            label = "LTQ";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <180>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&lt 3 Q             &kp W         &kp E             &kp R                       &kp T                                            &kp Y                        &kp U  &lt 5 I    &kp O       &kp P
&kp A               &kp S         &kp D             &kp F                       &kp G                             &kp BACKSPACE  &kp H                        &kp J  &kp K      &kp L       &lt 8 MINUS
&mt LEFT_SHIFT Z    &kp X         &kp C             &kp V                       &kp B             &kp TAB         &kp DELETE     &kp N                        &kp M  &kp COMMA  &kp PERIOD  &kp SLASH
&mt LEFT_SHIFT ESC  &kp LEFT_ALT  &kp LEFT_COMMAND  &lt_to_layer_0 1 BACKSPACE  &lt 2 LANGUAGE_2  &ltq 8 SPACE    &kp ENTER      &mt LEFT_CONTROL LANGUAGE_1                                &lt 5 DELETE
            >;

            sensor-bindings = <&encoder_scroll>;   // マウスホイール上下スクロール
            display-name = "BASE";
        };

        ARROW {
            bindings = <
&kp ESCAPE  &kp PAGE_DOWN            &kp UP_ARROW             &kp PAGE_UP              &kp TAB                       &trans           &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &trans
&kp HOME    &kp LEFT_ARROW           &kp DOWN_ARROW           &kp RIGHT_ARROW          &kp END               &trans  &trans           &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_MINUS
&trans      &kp LS(LG(KP_NUMBER_3))  &kp LS(LG(KP_NUMBER_4))  &kp LS(LG(KP_NUMBER_5))  &trans   &kp LC(K)    &trans  &kp KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp KP_SLASH
&trans      &trans                   &trans                   &trans                   &trans   &trans       &trans  &trans                                                              &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(MINUS) LG(PLUS)>;
            display-name = "ARROW";
        };

        KIGOU {
            bindings = <
&kp SINGLE_QUOTE  &kp DOUBLE_QUOTES  &kp EQUAL   &kp SLASH  &kp TILDE                          &kp BACKSLASH  &kp UNDER  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp PERCENT
&kp AT            &kp STAR           &kp DOLLAR  &kp PIPE   &kp GRAVE                  &trans  &kp HASH       &kp STAR   &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp SEMICOLON
&kp PLUS          &kp PLUS           &kp COLON   &kp CARET  &kp EXCLAMATION  &trans    &trans  &kp AMPERSAND  &kp MINUS  &kp LESS_THAN         &kp GREATER_THAN       &kp QUESTION
&trans            &trans             &trans      &trans     &trans           &trans    &trans  &trans                                                                 &trans
            >;

            sensor-bindings = <&inc_dec_kp LG(PLUS) LG(MINUS)>;
            display-name = "KIGOU";
        };

        Bluetooth {
            bindings = <
&trans  &trans  &trans  &trans  &trans                         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans  &trans  &trans  &trans  &trans            &trans       &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans    &bootloader  &trans        &trans        &trans        &trans        &bt BT_CLR
&trans  &trans  &trans  &trans  &trans  &trans    &trans       &trans                                                  &bt BT_CLR_ALL
            >;

            display-name = "BT";
        };

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            display-name = "MOUSE";
        };

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans                          &trans
            >;

            display-name = "SCROLL";
        };

        NUM {
            bindings = <
&kp MINUS                   &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp PLUS                                       &kp CARET         &kp AMPERSAND      &kp TILDE       &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&kp SLASH                   &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp ASTERISK                   &kp UNDERSCORE  &kp EXCLAMATION   &kp AT_SIGN        &kp HASH        &kp DOLLAR            &kp PERCENT
&mt LEFT_SHIFT KP_NUMBER_0  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &kp PERIOD    &kp EQUAL        &trans          &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp LEFT_BRACE  &kp RIGHT_BRACE       &kp BACKSLASH
&trans                      &trans           &trans           &kp DELETE       &trans        &kp LG(SPACE)    &trans          &trans                                                                     &kp PIPE
            >;

            display-name = "NUM";
        };

        FUNCTION {
            bindings = <
&trans  &trans  &trans  &trans  &trans                     &kp F1  &kp F2  &kp F3  &kp F4  &kp F5
&trans  &trans  &trans  &trans  &trans            &kp F13  &kp F6  &kp F7  &kp F8  &kp F9  &kp F10
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans  &trans  &trans  &trans  &kp F11
&trans  &trans  &trans  &trans  &trans  &trans    &trans   &trans                          &kp F12
            >;

            display-name = "FUNC";
        };

        GESTURE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                       &trans  &kp LG(LEFT_BRACKET)  &kp LC(UP)    &kp LG(RIGHT_BRACKET)  &trans
&trans  &trans  &trans  &trans  &trans            &kp LG(W)  &trans  &kp LC(LEFT)          &kp LC(DOWN)  &kp LC(RIGHT)          &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans  &trans                &trans        &trans                 &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans                                                             &trans
            >;

            display-name = "GEST";
        };
    };
};
